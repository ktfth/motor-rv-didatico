<?xml version="1.0" encoding="UTF-8"?>
<!--
  Vocabulário do log de eventos do motor-rv.

  Regras que este arquivo obedece, e que o gerador (scripts/sbe_gen.py) FORÇA:
    - campos ordenados por alinhamento decrescente (8, 4, 2, 1) e padding EXPLÍCITO até múltiplo
      de 8. O gerador recusa schema mal ordenado em vez de reordenar por conta própria: o layout
      é decisão de quem escreve o formato, não do gerador.
    - `blockLength` é DECLARADO em cada mensagem e o gerador o CONFERE contra a soma dos campos.
      Sem a declaração, o número que os `static_assert` comparam com o compilador vinha da
      aritmética do próprio gerador: ele só provava que o gerador concorda consigo mesmo. Com a
      declaração, o XML é a autoridade e o gerador é o verificado.
    - templateId é IMUTÁVEL. Mudar o significado de um template existente é proibido (contrato de
      determinismo D7); comportamento novo pede template novo e bump de `version`.
    - dinheiro, quantidade e preço são `int64` com a escala de ADR-0007: 1e-8 para quantidade e
      preço, 1e-4 para BRL. O campo guarda o `raw()` do Fixed correspondente.
    - datas são `uint32` AAAAMMDD. Nenhuma data é calculada dentro do motor: o ingress resolve o
      calendário (data/calendario-b3-2026.csv) e grava o resultado aqui. Ler calendário durante o
      replay violaria I12.
-->
<sbe:messageSchema xmlns:sbe="http://fixprotocol.io/2016/sbe"
                   package="rv.codec" id="1" version="1"
                   semanticVersion="1.0" byteOrder="littleEndian"
                   description="Eventos do log do motor-rv">

  <types>
    <type name="Symbol12" primitiveType="char" length="12" description="ticker, preenchido com NUL"/>
    <type name="Isin12"   primitiveType="char" length="12" description="ISIN, 12 caracteres"/>
    <type name="Pad2"     primitiveType="uint8" length="2"/>
    <type name="Pad3"     primitiveType="uint8" length="3"/>
    <type name="Pad4"     primitiveType="uint8" length="4"/>
    <type name="Pad6"     primitiveType="uint8" length="6"/>
    <type name="Pad7"     primitiveType="uint8" length="7"/>

    <enum name="Side" encodingType="uint8" description="lado do negócio">
      <validValue name="Buy">1</validValue>
      <validValue name="Sell">2</validValue>
    </enum>

    <enum name="Market" encodingType="uint8" description="lote padrão ou fracionário">
      <validValue name="RoundLot">1</validValue>
      <validValue name="Fractional">2</validValue>
    </enum>

    <enum name="SettleOutcome" encodingType="uint8"
          description="como a janela da câmara terminou; FalhaEntrega vive aqui, não em template próprio">
      <validValue name="Settled">1</validValue>
      <validValue name="DeliveryFailure">2</validValue>
      <validValue name="BoughtIn">3</validValue>
    </enum>

    <enum name="ActionType" encodingType="uint8" description="linhas da tabela de docs/dominio.md">
      <validValue name="Bonus">1</validValue>
      <validValue name="Split">2</validValue>
      <validValue name="ReverseSplit">3</validValue>
      <validValue name="Subscription">4</validValue>
      <validValue name="LeftoversAuction">5</validValue>
    </enum>

    <enum name="IncomeKind" encodingType="uint8">
      <validValue name="Dividend">1</validValue>
      <validValue name="Jcp">2</validValue>
      <validValue name="FiiIncome">3</validValue>
    </enum>

    <enum name="IncomeStage" encodingType="uint8"
          description="Accrued credita proventos_a_receber; Paid move para caixa">
      <validValue name="Accrued">1</validValue>
      <validValue name="Paid">2</validValue>
    </enum>

    <enum name="InstrumentType" encodingType="uint8">
      <validValue name="Stock">1</validValue>
      <validValue name="Etf">2</validValue>
      <validValue name="Fii">3</validValue>
      <validValue name="Bdr">4</validValue>
    </enum>
  </types>

  <sbe:message blockLength="24" name="DayOpened" id="1"
               description="abre o dia com o calendário JÁ resolvido pelo ingress">
    <field name="business_date"      id="1" type="uint32" description="D"/>
    <field name="prev_business_date" id="2" type="uint32" description="D-1 útil: base do snapshot de exposição"/>
    <field name="settle_d1"          id="3" type="uint32" description="D+1 em pregões"/>
    <field name="settle_d2"          id="4" type="uint32" description="D+2 em pregões, ciclo padrão"/>
    <field name="schema_version"     id="5" type="uint16" description="versão de schema do produtor"/>
    <field name="partition_id"       id="6" type="uint16" description="redundante com o segmento: detecta arquivo trocado"/>
    <field name="pad"                id="7" type="Pad4"/>
  </sbe:message>

  <sbe:message blockLength="88" name="TradeExecuted" id="2" description="o negócio como veio do drop copy">
    <field name="trade_id"       id="1"  type="uint64" description="único no dia"/>
    <field name="broker_note_id" id="2"  type="uint64" description="nota de corretagem (R13)"/>
    <field name="account"        id="3"  type="uint64" description="DocumentId do titular na execução"/>
    <field name="qty"            id="4"  type="int64"  description="Qty raw (1e-8)"/>
    <field name="price"          id="5"  type="int64"  description="Price raw (1e-8)"/>
    <field name="brokerage_fee"  id="6"  type="int64"  description="Money raw (1e-4)"/>
    <field name="exchange_fee"   id="7"  type="int64"  description="emolumentos"/>
    <field name="clearing_fee"   id="8"  type="int64"  description="taxa de liquidação"/>
    <field name="taxes"          id="9"  type="int64"  description="retidos na nota"/>
    <field name="instrument"     id="10" type="uint32" description="InstrumentId já internado"/>
    <field name="settlement_date" id="11" type="uint32" description="DateYmd; NÃO é recalculada no apply"/>
    <field name="flags"          id="12" type="uint16" description="bit0 day trade; bit1 venda descoberta autorizada (I3)"/>
    <field name="side"           id="13" type="Side"/>
    <field name="market"         id="14" type="Market"/>
    <field name="pad"            id="15" type="Pad4"/>
  </sbe:message>

  <sbe:message blockLength="64" name="TradeAllocated" id="3" description="alocação ao investidor final; pode fatiar o negócio">
    <field name="allocation_id"  id="1" type="uint64"/>
    <field name="trade_id"       id="2" type="uint64"/>
    <field name="from_account"   id="3" type="uint64" description="DocumentId de origem (conta da corretora)"/>
    <field name="to_account"     id="4" type="uint64" description="DocumentId do investidor final"/>
    <field name="qty"            id="5" type="int64"/>
    <field name="cash_amount"    id="6" type="int64"  description="parcela do financeiro, custos já rateados"/>
    <field name="instrument"     id="7" type="uint32"/>
    <field name="settlement_date" id="8" type="uint32"/>
    <field name="side"           id="9" type="Side"/>
    <field name="pad"            id="10" type="Pad7"/>
  </sbe:message>

  <sbe:message blockLength="32" name="BatchNetted" id="4" description="net multilateral da câmara por conta e data">
    <field name="batch_id"        id="1" type="uint64"/>
    <field name="account"         id="2" type="uint64" description="DocumentId"/>
    <field name="net_amount"      id="3" type="int64"  description="Money raw; positivo credita"/>
    <field name="settlement_date" id="4" type="uint32"/>
    <field name="trade_count"     id="5" type="uint32" description="quantos negócios entraram no net"/>
  </sbe:message>

  <sbe:message blockLength="56" name="TradeSettled" id="5" description="liquidação ou falha na janela da câmara">
    <field name="batch_id"        id="1" type="uint64"/>
    <field name="account"         id="2" type="uint64" description="DocumentId"/>
    <field name="qty"             id="3" type="int64"/>
    <field name="cash_amount"     id="4" type="int64" description="Money raw com sinal"/>
    <field name="cost_basis"      id="5" type="int64" description="Money raw; só em compra — entra no preço médio (I4)"/>
    <field name="instrument"      id="6" type="uint32"/>
    <field name="settlement_date" id="7" type="uint32" description="a data CONTRATADA, mesmo se vencida (cenário 06)"/>
    <field name="side"            id="8" type="Side"/>
    <field name="outcome"         id="9" type="SettleOutcome"/>
    <field name="pad"             id="10" type="Pad6"/>
  </sbe:message>

  <sbe:message blockLength="88" name="CorporateActionApplied" id="6"
               description="evento corporativo: só FATOS EXTERNOS; o preço médio é calculado pelo apply">
    <field name="action_id"          id="1"  type="uint64" description="chave de idempotência com account (I6)"/>
    <field name="account"            id="2"  type="uint64" description="DocumentId"/>
    <field name="qty_delta"          id="3"  type="int64"  description="informado pela depositária quando flags bit0; senão 0 e o apply deriva"/>
    <field name="leftover_delta"     id="4"  type="int64"  description="fração para sobras, na unidade CORRENTE (cenário 08)"/>
    <field name="cash_delta"         id="5"  type="int64"  description="subscrição debita; leilão de sobras credita"/>
    <field name="withheld_tax"       id="6"  type="int64"  description="Money raw"/>
    <field name="unit_cost"          id="7"  type="int64"  description="Money raw por ação: custo atribuído (bonificação) ou preço de emissão (subscrição)"/>
    <field name="instrument"         id="8"  type="uint32"/>
    <field name="result_instrument"  id="9"  type="uint32" description="papel resultante; == instrument quando não muda"/>
    <field name="ex_date"            id="10" type="uint32"/>
    <field name="com_date"           id="11" type="uint32" description="posição-base é a desta data"/>
    <field name="factor_num"         id="12" type="uint32" description="desdobramento 1:10 => num=10 den=1"/>
    <field name="factor_den"         id="13" type="uint32" description="grupamento 10:1 => num=1 den=10"/>
    <field name="type"               id="14" type="ActionType"/>
    <field name="flags"              id="15" type="uint8"  description="bit0 qty_delta informado (verificar em vez de derivar)"/>
    <field name="pad"                id="16" type="Pad6"/>
  </sbe:message>

  <sbe:message blockLength="72" name="DividendPaid" id="7"
               description="provento em dinheiro; os valores são do pagador — o apply VERIFICA, não recalcula (cenário 10)">
    <field name="action_id"      id="1"  type="uint64"/>
    <field name="account"        id="2"  type="uint64" description="DocumentId"/>
    <field name="qty_basis"      id="3"  type="int64"  description="posição na data-com"/>
    <field name="rate_per_share" id="4"  type="int64"  description="Money raw por ação"/>
    <field name="gross_amount"   id="5"  type="int64"  description="creditado pelo pagador, em centavos"/>
    <field name="withheld_tax"   id="6"  type="int64"  description="IRRF na fonte (JCP: 15%)"/>
    <field name="net_amount"     id="7"  type="int64"  description="apply exige gross - withheld == net"/>
    <field name="instrument"     id="8"  type="uint32"/>
    <field name="ex_date"        id="9"  type="uint32"/>
    <field name="payment_date"   id="10" type="uint32"/>
    <field name="kind"           id="11" type="IncomeKind"/>
    <field name="stage"          id="12" type="IncomeStage"/>
    <field name="pad"            id="13" type="Pad2"/>
  </sbe:message>

  <sbe:message blockLength="64" name="ClosingPriceSet" id="8"
               description="fechamento do dia E cadastro do instrumento: o replay reconstrói a tabela sem ler arquivo (I12)">
    <field name="closing_price"  id="1"  type="int64"  description="Price raw"/>
    <field name="previous_close" id="2"  type="int64"  description="Price raw"/>
    <field name="instrument"     id="3"  type="uint32" description="InstrumentId atribuído pelo ingress"/>
    <field name="date"           id="4"  type="uint32"/>
    <field name="price_factor"   id="5"  type="uint32" description="fator de cotação (I7)"/>
    <field name="lot_size"       id="6"  type="uint32" description="lote padrão"/>
    <field name="symbol"         id="7"  type="Symbol12"/>
    <field name="isin"           id="8"  type="Isin12"/>
    <field name="type"           id="9"  type="InstrumentType"/>
    <field name="status"         id="10" type="uint8" description="0 normal, 1 suspenso"/>
    <field name="pad"            id="11" type="Pad6"/>
  </sbe:message>

  <sbe:message blockLength="16" name="CustodyReconciled" id="9"
               description="fatiado: até 16 divergências por evento para caber no slot do ring">
    <field name="date"        id="1" type="uint32"/>
    <field name="chunk_index" id="2" type="uint32"/>
    <field name="chunk_count" id="3" type="uint32"/>
    <field name="flags"       id="4" type="uint8" description="bit0 = último chunk"/>
    <field name="pad"         id="5" type="Pad3"/>
    <group blockLength="24" name="divergence" id="10" maxOccurrences="16" description="depositária menos motor">
      <field name="account"    id="1" type="uint64" description="DocumentId"/>
      <field name="qty_delta"  id="2" type="int64"  description="Qty raw; positivo = depositária tem mais"/>
      <field name="instrument" id="3" type="uint32"/>
      <field name="pad"        id="4" type="Pad4"/>
    </group>
  </sbe:message>

  <sbe:message blockLength="32" name="EodMarked" id="10"
               description="fim do dia com âncora de conferência: dois uint64 que I11 compara depois do replay">
    <field name="custody_checksum"  id="1" type="uint64" description="soma dos raw de todos os buckets de quantidade"/>
    <field name="cash_checksum"     id="2" type="uint64" description="soma dos raw de todos os buckets financeiros"/>
    <field name="date"              id="3" type="uint32"/>
    <field name="instrument_count"  id="4" type="uint32"/>
    <field name="account_count"     id="5" type="uint32"/>
    <field name="flags"             id="6" type="uint32" description="bit0 = houve divergência de reconciliação"/>
  </sbe:message>

</sbe:messageSchema>
